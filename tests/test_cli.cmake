function(succeeds)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 0 OR NOT error STREQUAL "")
    message(FATAL_ERROR "CLI failed: ${ARGN}: ${status}: ${error}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
endfunction()
function(rejects)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(status EQUAL 0 OR NOT error MATCHES "Error:" OR NOT output STREQUAL "")
    message(FATAL_ERROR "Invalid CLI contract: ${ARGN}: ${status}: ${output}: ${error}")
  endif()
  set(last_error "${error}" PARENT_SCOPE)
endfunction()
